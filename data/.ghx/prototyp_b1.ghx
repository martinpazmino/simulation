                            <item name="Description" type_name="gh_string" type_code="10">Text to set the name for the Aperture and to be incorporated into
unique Aperture identifier. If the name is not provided, a random name
will be assigned.</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">0e435a8c-c2a0-4923-b202-ca6e79fbefe5</item>
                            <item name="Name" type_name="gh_string" type_code="10">_name_</item>
                            <item name="NickName" type_name="gh_string" type_code="10">_name_</item>
                            <item name="Optional" type_name="gh_bool" type_code="1">true</item>
