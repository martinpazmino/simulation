                      <ARGB>0;100;150;75</ARGB>
                    </item>
                    <item name="Description" type_name="gh_string" type_code="10">A group of Grasshopper objects</item>
                    <item name="ID" index="0" type_name="gh_guid" type_code="9">6971600c-3412-4a72-8f34-b690f66c1914</item>
                    <item name="ID_Count" type_name="gh_int32" type_code="3">1</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">c839862e-6a5d-428b-9f88-accc43a8eff5</item>
                    <item name="Name" type_name="gh_string" type_code="10">Group</item>
                    <item name="NickName" type_name="gh_string" type_code="10">HB Opaque Material</item>
