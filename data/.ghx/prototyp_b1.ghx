                            <item name="Description" type_name="gh_string" type_code="10">Set to "True" to count the input _geometry as opaque and
set to "False" to discount the _geometry from the calculation and
only look at context_ that blocks the sun. (Default: True).</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">d7328550-8783-4895-a762-232fe4727a17</item>
                            <item name="Name" type_name="gh_string" type_code="10">geo_block_</item>
                            <item name="NickName" type_name="gh_string" type_code="10">geo_block_</item>
                            <item name="Optional" type_name="gh_bool" type_code="1">true</item>
                            <item name="ScriptParamAccess" type_name="gh_int32" type_code="3">0</item>
