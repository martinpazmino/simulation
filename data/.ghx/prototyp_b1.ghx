                      <ARGB>0;100;150;75</ARGB>
                    </item>
                    <item name="Description" type_name="gh_string" type_code="10">A group of Grasshopper objects</item>
                    <item name="ID" index="0" type_name="gh_guid" type_code="9">58670e08-187c-4ab2-aca5-c8421d8bff5f</item>
